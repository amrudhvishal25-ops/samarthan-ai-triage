# Environment Variables — Samarthan Golden Hour Triage

# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# OpenAI API Key — required for live AI processing
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# If left empty, the app runs in MOCK MODE (pre-baked responses)
# Mock mode is fully functional for hackathon demos

# Supabase — stores complaints so they persist across sessions/devices
# Get these from Supabase Dashboard → Project Settings → API
# If left empty, complaints are saved to the browser's localStorage instead
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
