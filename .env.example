# Environment Variables — Samarthan Golden Hour Triage
# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Required for real AI triage (GPT-4o-mini). Without this, the app falls back
# to a rule-based mock triage so you can still run the UI with zero setup.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Base URL of your running app (used in generated links/messages).
NEXT_PUBLIC_APP_URL=http://localhost:3000
